# Required for Live mode. Obtain from https://open.mcd.cn/mcp
MCD_MCP_TOKEN=
# Optional: LLM for richer judge language. The app uses a deterministic fallback when absent.
OPENAI_API_KEY=

# Optional. Enables AI-written judge copy; deterministic judge remains the fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash:nitro
OPENROUTER_SITE_URL=https://mccourt.vercel.app
